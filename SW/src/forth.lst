                      (        forth.asm):00131         
                      (        forth.asm):00132         * Unchecked NPUSH. This is for situations in which there is absolutely no
                      (        forth.asm):00133         * chance of overflow. For instance, in case we just popped 2 cells and push
                      (        forth.asm):00134         * back one or two.
0000                  (        forth.asm):00135         UCNPUSH MACRO   NOEXPAND
                      (        forth.asm):00136                 pshu    x
                      (        forth.asm):00137                 ENDM
                      (        forth.asm):00138         
                      (        forth.asm):00139         * Unchecked NPOP. To be used only after trusted words have been invoked, i.e.
                      (        forth.asm):00140         * when one is positively sure that the data stack contains at least one cell.
0000                  (        forth.asm):00141         UCNPOP  MACRO   NOEXPAND
                      (        forth.asm):00142                 pulu    x
                      (        forth.asm):00143                 ENDM
                      (        forth.asm):00144         
                      (        forth.asm):00145         * Make sure minimum data stack requirements are satisfied upon word entry.
                      (        forth.asm):00146         * The requirement is expressed in cell size--2 bytes on the 6309.
                      (        forth.asm):00147         * \1 specifies the required number of cells.
0000                  (        forth.asm):00148         MINDREQ MACRO   NOEXPAND
                      (        forth.asm):00149                 ldd     #NSTBOT-(\1*2)  Cell count one expects to be stacked up
                      (        forth.asm):00150                 bra     CHKNDPT         No return if the condition is not met
                      (        forth.asm):00151                 ENDM
                      (        forth.asm):00152         
                      (        forth.asm):00153         * Reliability feature support: execution tokens.
                      (        forth.asm):00154         * \1 has the opcode we want to emit.
                      (        forth.asm):00155         * \2 has the execution token address, as if the header overhead always
                      (        forth.asm):00156         * was 3 bytes.
0000                  (        forth.asm):00157         RFXT    MACRO   NOEXPAND
                      (        forth.asm):00158                 IFNE    RELFEAT
                      (        forth.asm):00159                 \1      \2+1
                      (        forth.asm):00160                 ELSE
                      (        forth.asm):00161                 \1      \2
                      (        forth.asm):00162                 ENDC                    RELFEAT
                      (        forth.asm):00163                 ENDM
                      (        forth.asm):00164         
                      (        forth.asm):00165         * Reliability feature support: variable word header contents.
                      (        forth.asm):00166         * This is a dummy checksum only used for EEPROM resident words.
                      (        forth.asm):00167         * Those never are checked for code integrity by MONITOR.
0000                  (        forth.asm):00168         RFCS    MACRO   NOEXPAND
                      (        forth.asm):00169                 IFNE    RELFEAT
                      (        forth.asm):00170                 fcb     ILLOPC          Illegal opcode
                      (        forth.asm):00171                 ENDC                    RELFEAT
                      (        forth.asm):00172                 ENDM
                      (        forth.asm):00173         
