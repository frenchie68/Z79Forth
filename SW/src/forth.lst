                      (        forth.asm):03665         *
                      (        forth.asm):03666         * Stack structure:
                      (        forth.asm):03667         * ,s    Return address          16 bits
                      (        forth.asm):03668         * 2,s   Remainder               16 bits
                      (        forth.asm):03669         * 4,s   Bitmask high            16 bits
                      (        forth.asm):03670         * 6,s   Bitmask low             16 bits
                      (        forth.asm):03671         * 8,s   Quotient high           16 bits
                      (        forth.asm):03672         * 10,s  Quotient low            16 bits
                      (        forth.asm):03673         * 12,s  Numerator high          16 bits
                      (        forth.asm):03674         * 14,s  Numerator low           16 bits
                      (        forth.asm):03675         * 16,s  Denominator             16 bits
