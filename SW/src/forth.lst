                      (    constants.asm):00197         * Division function codes and options.
     0000             (    constants.asm):00198         DVFSLMD equ     0               Function is /MOD
     0001             (    constants.asm):00199         DVFMOD  equ     1               Function is MOD
     0002             (    constants.asm):00200         DVFDIV  equ     2               Function is /
     0008             (    constants.asm):00201         DVOA1D  equ     8               Argument 1 is a double (FM/MOD SM/REM)
     0010             (    constants.asm):00202         DVOWSYM equ     16              Want symmetric division (default is floored)
     0007             (    constants.asm):00203         DVFMASK equ     7               Mask for extracting function codes
                      (    constants.asm):00204         
     001F             (    constants.asm):00205         WRLNMSK equ     $1F             31 character is the maximum word length
                      (    constants.asm):00206         
                      (    constants.asm):00207         * 6309 opcodes.
     008E             (    constants.asm):00208         LDXOPC  equ     $8E             LDX (immediate)
     007E             (    constants.asm):00209         JMPOPC  equ     $7E             JMP (extended)
     00BD             (    constants.asm):00210         JSROPC  equ     $BD             JSR (extended)
     0039             (    constants.asm):00211         RTSOPC  equ     $39             RTS (inherent)
     2503             (    constants.asm):00212         BCSOPC  equ     $2503           BCS *+5 (relative)
     2603             (    constants.asm):00213         BNEOPC  equ     $2603           BNE *+5 (relative)
     00C7             (    constants.asm):00214         ILLOPC  equ     $C7             An illegal operation code. Meant to raise a trap
                      (    constants.asm):00215         
     0001             (    constants.asm):00216         CFLAG   equ     1               CC bit 0 (C)
     0004             (    constants.asm):00217         ZFLAG   equ     4               CC bit 2 (Z)
     0010             (    constants.asm):00218         IFLAG   equ     $10             CC bit 4 (I)
     0040             (    constants.asm):00219         FFLAG   equ     $40             CC bit 6 (F)
                      (    constants.asm):00220         
                      (    constants.asm):00221         * RAM based execution token for @.
     0E34             (    constants.asm):00222         RAMFTCH set     WDICSPC+4       Dictionary header overhead is word's length + 3
                      (    constants.asm):00223                 IFNE    RELFEAT         The reliability features adds one byte to the
     0E35             (    constants.asm):00224         RAMFTCH set     WDICSPC+5       header: a checksum.
                      (    constants.asm):00225                 ENDC
                      (    constants.asm):00226         
                      (    constants.asm):00227         * Error condition codes passed through Breg to SYSTHR8.
     FFFF             (    constants.asm):00228         EABORT  equ     -1      STD -- ABORT
     FFFE             (    constants.asm):00229         EABRTQ  equ     -2      STD -- ABORT"
     FFFD             (    constants.asm):00230         EDSOVF  equ     -3      STD -- DS overflow
     FFFC             (    constants.asm):00231         EDSUDF  equ     -4      STD -- DS underflow
     FFFB             (    constants.asm):00232         ERSOVF  equ     -5      STD -- RS overflow
     FFFA             (    constants.asm):00233         ERSUDF  equ     -6      STD -- RS underflow
     FFF7             (    constants.asm):00234         ESSEGV  equ     -9      STD -- Illegal argument (CHAR FIND PICK EXECUTE)
     FFF6             (    constants.asm):00235         EDIVZR  equ     -10     STD -- Division by zero (TRAP)
     FFF5             (    constants.asm):00236         EOORNG  equ     -11     STD -- OoR error
     FFF3             (    constants.asm):00237         EUNDEF  equ     -13     STD -- ? / Undefined word
     FFF2             (    constants.asm):00238         ESTATE  equ     -14     STD -- Incorrect STATE
     FFF0             (    constants.asm):00239         ENONAM  equ     -16     STD -- Missing word (POSTPONE : CREATE)
     FFED             (    constants.asm):00240         ENAMLN  equ     -19     STD -- Name too long
     FFEC             (    constants.asm):00241         ERONLY  equ     -20     STD -- RO word
     FFEB             (    constants.asm):00242         ENOSUP  equ     -21     STD -- IO error or TRAP (ILOP)
     FFEA             (    constants.asm):00243         EILCST  equ     -22     STD -- Illegal construct
     FFE4             (    constants.asm):00244         EUINTR  equ     -28     STD -- SIGINT
