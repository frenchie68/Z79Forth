                      (        forth.asm):03535         * 6,s   Bitmask low             16 bits
                      (        forth.asm):03536         * 8,s   Quotient high           16 bits
                      (        forth.asm):03537         * 10,s  Quotient low            16 bits
                      (        forth.asm):03538         * 12,s  Numerator high          16 bits
                      (        forth.asm):03539         * 14,s  Numerator low           16 bits
                      (        forth.asm):03540         * 16,s  Denominator             16 bits
